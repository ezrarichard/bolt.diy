# `/build/*` (contents) rather than `/build` (the directory): git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so the negation below was silently ineffective and
# build/server.d.ts — the checked-in type declaration functions/[[path]].ts depends on — could
# never be committed. Excluding the contents instead lets the negation work.
/build/*
!/build/server.d.ts
functions/build/
.env.local
.env
.dev.vars
*.vars
.wrangler
_worker.bundle

Modelfile
modelfiles

# docs ignore
site

# commit file ignore
app/commit.json
changelogUI.md
.cursorrules

# Ignore stray/generated markdown anywhere in the repo (changelogs, scratch notes, etc.),
# but never the documentation knowledge base under docs/ — every doc there must be trackable.
*.md
!docs/**/*.md
# ...except this specific legacy path, kept ignored to preserve the original rule's intent
# (the file/folder doesn't exist in this codebase, so this is currently a no-op).
docs/instructions/Roadmap.md

